# Copy to .env and fill in. Never commit .env.
# Variables set by your MCP client's "env" block take precedence over this file.

# Graph API version (default v24.0)
META_GRAPH_API_VERSION=v24.0

# Required: the Page to manage and a Page access token with
# pages_manage_posts, pages_read_engagement, read_insights.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Optional: user token for fb_list_pages and for `facebook-mcp-token`.
FB_USER_ACCESS_TOKEN=

# Optional: app id/secret, so `facebook-mcp-token` can extend a 1-hour user
# token to 60 days and return a Page token that does not expire.
FB_APP_ID=
FB_APP_SECRET=

# Optional safety settings
# FB_MCP_READ_ONLY=1                       # hide all publish/schedule/delete tools
# FB_MCP_ALLOWED_DIRS=/path/a:/path/b      # only upload media from these folders
# FB_MCP_LOG_LEVEL=INFO                    # logs go to stderr
